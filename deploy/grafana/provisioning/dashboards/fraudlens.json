{
 "uid": "fraudlens",
 "title": "FraudLens",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Độ trễ làn nhanh (p50, p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(api_transaction_latency_seconds_bucket[5m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(api_transaction_latency_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Giao dịch theo luồng (mỗi giây)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(api_routes_total[5m])) by (route)",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Trạng thái chấm điểm",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(api_score_status_total[5m])) by (status)",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "PSI theo feature (0,1 cảnh báo · 0,2 hành động)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fraudlens_psi",
     "legendFormat": "{{feature}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Hồ sơ đang mở",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fraudlens_open_cases",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Brief theo nguồn",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(worker_briefs_total[15m])) by (source)",
     "legendFormat": "{{source}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Chất lượng trên nhãn trễ",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fraudlens_label_metric{metric!=\"labels_count\"}",
     "legendFormat": "{{metric}}"
    }
   ]
  }
 ]
}