# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# Khóa băm số thẻ (>= 16 ký tự, giữ bí mật, không đổi sau khi đã có dữ liệu)
HMAC_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Khóa cho nguồn giao dịch / nhãn (simulator gửi kèm header X-API-Key). start.ps1 tự thay bằng chuỗi ngẫu nhiên;
# tự tạo .env bằng tay thì đổi dòng này (để nguyên dev-source-key, trang Hệ thống sẽ cảnh báo).
SOURCE_API_KEY=dev-source-key
# Tài khoản web do Admin cấp (không tự đăng ký, không token tĩnh). Tài khoản Admin đầu tiên:
#   docker compose exec api python -m fraudlens.tools.admin create-user admin admin
# Thời hạn phiên đăng nhập (giờ)
SESSION_TTL_H=168

# Kết nối khi chạy trực tiếp trên máy (docker-compose tự thay bằng tên service)
DATABASE_URL=postgresql://fraudlens:fraudlens@localhost:5432/fraudlens
REDIS_URL=redis://localhost:6379/0
SCORER_URL=http://localhost:8001
REGISTRY_DIR=registry
PLAYBOOK_PATH=kb/playbook.md
KB_VERSION=draft-0

# Làn nhanh
SCORER_TIMEOUT_S=0.15
BREAKER_FAIL_THRESHOLD=5
BREAKER_OPEN_S=10
API_WORKERS=2
# Khóa theo thẻ (xử lý tuần tự giao dịch cùng thẻ) và kiểm tra độ tươi theo thời gian luồng
CARD_LOCK_TTL_S=2
CARD_LOCK_WAIT_S=0.5
MAX_FUTURE_S=86400
MAX_LATE_S=86400

# LLM (để trống LLM_API_KEY thì worker dùng brief dạng mẫu, hệ thống vẫn chạy đủ)
# Mặc định: Qwen chạy trên máy bằng Ollama – miễn phí, không giới hạn lượt gọi, dữ liệu không rời máy.
# Cài Ollama (ollama.com) rồi: ollama pull qwen2.5:7b. LLM_API_KEY chỉ cần khác rỗng; để trống = tắt LLM.
# Nhà cung cấp khác (Qwen cloud, Groq, Gemini): xem README, Bước 10.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=180
LLM_RETRIES=1
# Lỗi tạm thời của LLM (429 hết hạn mức, 503 quá tải, quá thời gian chờ): thử lại N lần, chờ 5 s rồi gấp đôi
LLM_TRANSIENT_RETRIES=2
LLM_RETRY_BACKOFF_S=5
LLM_MIN_INTERVAL_S=0

# Giám sát
MONITOR_INTERVAL_S=300
PSI_WARN=0.1
PSI_ALERT=0.2
MONITOR_RATE_WINDOW=5000
UNSCORED_WARN=0.03
UNSCORED_ALERT=0.10
MIN_LABEL_FRAUDS=30
# Tỉ lệ hồ sơ nhóm đối chứng không hiển thị brief (đo giá trị brief); 0 = luôn hiển thị
BRIEF_HOLDOUT_FRAC=0
