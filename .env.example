# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# Khóa băm số thẻ (>= 16 ký tự, giữ bí mật, không đổi sau khi đã có dữ liệu)
HMAC_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Khóa cho nguồn giao dịch / nhãn (simulator gửi kèm header X-API-Key)
SOURCE_API_KEY=dev-source-key
# Token đăng nhập dashboard (bản đồ án): ten:token:vai_tro, vai trò: analyst | risk_lead | admin
DASHBOARD_TOKENS=analyst:analyst-token:analyst,lead:lead-token:risk_lead,admin:admin-token:admin

# Kết nối khi chạy trực tiếp trên máy (docker-compose tự thay bằng tên service)
DATABASE_URL=postgresql://fraudlens:fraudlens@localhost:5432/fraudlens
REDIS_URL=redis://localhost:6379/0
SCORER_URL=http://localhost:8001
REGISTRY_DIR=registry
PLAYBOOK_PATH=kb/playbook.md
KB_VERSION=draft-0

# Làn nhanh
SCORER_TIMEOUT_S=0.15
BREAKER_FAIL_THRESHOLD=5
BREAKER_OPEN_S=10
API_WORKERS=2

# LLM (để trống LLM_API_KEY thì worker dùng brief dạng mẫu, hệ thống vẫn chạy đủ)
# Lấy key ở Google AI Studio; kiểm tra tên model hiện có trong trang của Google trước khi điền.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_S=20
LLM_RETRIES=1
LLM_MIN_INTERVAL_S=4

# Giám sát
MONITOR_INTERVAL_S=300
PSI_WARN=0.1
PSI_ALERT=0.2
